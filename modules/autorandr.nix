# autorandr.nix
{ pkgs, ... }:

{
  services.autorandr = {
    enable = true;
    defaultTarget = "mobile";
    
    profiles = {
      "docked" = {
        fingerprint = {
          "DP-1-0.2" = "";
          "DP-1-0.1" = "";
          "eDP" = "";
        };
        config = {
          "DP-1-0.2" = {
            enable = true;
            primary = true;
            position = "0x0";
            mode = "1920x1080";
            rate = "60.00";
          };
          "DP-1-0.1" = {
            enable = true;
            position = "1920x0";
            mode = "1920x1080";
            rate = "60.00";
          };
          "eDP" = {
            enable = false;
          };
        };
                #${pkgs.procps}/bin/pkill dwm
        hooks.postswitch = {
          "notify" = "${pkgs.libnotify}/bin/notify-send 'Display Profile' 'Switched to docked setup'";
          "refresh-dwm" = "$HOME/nixos-config/scripts/reload-dwm";
        };
      };

      "mobile" = {
        fingerprint = {
          "eDP" = "";
        };
        config = {
          "eDP" = {
            enable = true;
            primary = true;
            position = "0x0";
            mode = "1920x1080";
            rate = "360.00";
          };
          "DP-1-0.2".enable = false;
          "DP-1-0.1".enable = false;
        };
        hooks.postswitch = {
          "notify" = "${pkgs.libnotify}/bin/notify-send 'Display Profile' 'Switched to mobile setup'";
        };
      };
    };
  };
}
